{
    "name": "aivie-recaptcha",
    "version": "7.0.0",
    "repository": {
        "type": "git",
        "url": "https://github.com/aiviemarketing/aivie-recaptcha"
    },
    "homepage": "https://aivie.ch/",
    "bugs": {
        "url": "https://github.com/aiviemarketing/aivie-recaptcha/issues"
    },
    "author": "aivie.ch",
    "license": "GPL-3.0-only",
    "keywords": [
        "mautic",
        "plugin",
        "integration",
        "aivie"
    ],
    "scripts": {
        "test": "ddev exec 'APP_ENV=test composer test plugins/AivieRecaptchaBundle'",
        "fixcs": "ddev exec composer fixcs plugins/AivieRecaptchaBundle",
        "changelog:preview": "standard-version --dry-run",
        "release": "gh workflow run 'Release' -r 6.x -f bump=patch -f slack_notify=true",
        "release:minor": "gh workflow run 'Release' -r 6.x -f bump=minor -f slack_notify=true",
        "release:major": "gh workflow run 'Release' -r 6.x -f bump=major -f slack_notify=true"
    },
    "devDependencies": {
        "@commitlint/cli": "^20.1.0",
        "@commitlint/config-conventional": "^20.0.0",
        "standard-version": "^9.5.0"
    }
}
